{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Usage-Pulse",
  "version": "3.0.0",
  "identifier": "com.xiaochen26wyl.usagepulse",
  "build": {
    "frontendDist": "../dist/renderer-tauri",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm exec vite build --config vite.tauri.config.ts"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Usage-Pulse",
        "url": "index.html",
        "width": 460,
        "height": 700,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws: wss: ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Quota monitor for Cursor, Claude Code and Codex",
    "longDescription": "Menu-bar tool that watches Cursor, Claude Code and Codex quota and sends desktop and LINE notifications.",
    "copyright": "Usage-Pulse contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "English",
          "Japanese",
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2MEY2NUI4OTVCNjRDOTMKUldTVFRMYVZ1R1VQOXVpVUJxQngxUUNyWG9wUVhZSlVGY3BhS3QyaTFnZXNna3hrMTF5K0luMVUK",
      "endpoints": [
        "https://github.com/xiaochen26wyl/Usage-Pulse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
