{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Usage-Pulse",
  "version": "2.3.0",
  "identifier": "com.xiaochen26wyl.usagepulse",
  "build": {
    "frontendDist": "../dist/renderer-tauri",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm exec vite build --config vite.tauri.config.ts"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Usage-Pulse",
        "url": "index.html",
        "width": 460,
        "height": 700,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
