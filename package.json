{
  "name": "usage-pulse",
  "version": "0.1.0",
  "description": "Cross-platform tray app to monitor AI quota usage with LINE alerts.",
  "main": "dist/main/index.js",
  "author": "zorawl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zorawl/Usage-Pulse.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:readonly": "node scripts/check-readonly.mjs",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac dmg --x64 --arm64",
    "dist:win": "pnpm build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "electron-store": "^10.0.1",
    "menubar": "^9.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.19"
  },
  "build": {
    "appId": "com.zorawl.usagepulse",
    "productName": "Usage-Pulse",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "packageManager": "pnpm@9.15.9"
}
