{
  "name": "usage-pulse",
  "version": "4.0.2",
  "description": "Cross-platform tray app to monitor AI quota usage with desktop alerts.",
  "author": "xiaochen26wyl",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaochen26wyl/Usage-Pulse.git"
  },
  "scripts": {
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "gen:rust-i18n": "tsx scripts/gen-rust-i18n.ts",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "build": "vite build --config vite.tauri.config.ts",
    "test:unit": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:readonly": "node scripts/check-readonly.mjs",
    "smoke:build": "node scripts/smoke-build.mjs",
    "git:start-work": "node scripts/git-workflow.mjs start-work",
    "git:start-branch": "node scripts/git-workflow.mjs start-branch",
    "git:sync-main": "node scripts/git-workflow.mjs sync-main",
    "git:check-sync": "node scripts/git-workflow.mjs check-sync",
    "git:push-wip": "node scripts/git-workflow.mjs push-wip",
    "git:finish-work": "node scripts/git-workflow.mjs finish-work",
    "git:merge-to-main": "node scripts/git-workflow.mjs merge-to-main",
    "git:cleanup-branches": "node scripts/git-workflow.mjs cleanup-branches",
    "git:issue-sync": "node scripts/github-issue-sync.mjs",
    "git:end-day": "node scripts/git-workflow.mjs end-day"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^5.4.19"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin",
        "win32"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ]
    }
  },
  "packageManager": "pnpm@9.15.9"
}
